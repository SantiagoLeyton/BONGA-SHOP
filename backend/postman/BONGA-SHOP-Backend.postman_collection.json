{
  "info": {
    "name": "BONGA SHOP Backend",
    "_postman_id": "f7467f0d-3c5e-4dd2-b7e0-1be6f5377f77",
    "description": "Collection for testing the modular monolith backend of BONGA SHOP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "" },
    { "key": "clientToken", "value": "" },
    { "key": "brandId", "value": "1" },
    { "key": "productId", "value": "1" },
    { "key": "variantId", "value": "1" },
    { "key": "orderId", "value": "1" },
    { "key": "userId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Client Demo\",\n  \"email\": \"client@bonga.shop\",\n  \"password\": \"Client123!\",\n  \"phone\": \"3001234567\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bonga.shop\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login Client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"client@bonga.shop\",\n  \"password\": \"Client123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{clientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Client Demo Updated\",\n  \"email\": \"client@bonga.shop\",\n  \"phone\": \"3007654321\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/users?page=0&size=10&search="
          }
        },
        {
          "name": "Update User Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/users/{{userId}}/status"
          }
        }
      ]
    },
    {
      "name": "Brands",
      "item": [
        {
          "name": "List Brands",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/brands"
          }
        },
        {
          "name": "Create Brand",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bonga Labs\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/brands"
          }
        },
        {
          "name": "Update Brand",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bonga Labs Updated\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/brands/{{brandId}}"
          }
        },
        {
          "name": "Delete Brand",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/brands/{{brandId}}"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products?page=0&size=10&search=&brandId=&minPrice=&maxPrice=&flavor=&nicotineLevel="
          }
        },
        {
          "name": "Get Product Detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bonga Mango Ice\",\n  \"description\": \"Disposable vape with mango flavor\",\n  \"brandId\": {{brandId}},\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/products"
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bonga Mango Ice Updated\",\n  \"description\": \"Updated description\",\n  \"brandId\": {{brandId}},\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "Variants",
      "item": [
        {
          "name": "List Product Variants",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{productId}}/variants"
          }
        },
        {
          "name": "Create Variant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flavor\": \"Mango\",\n  \"nicotineLevel\": \"3mg\",\n  \"price\": 25.00,\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/products/{{productId}}/variants"
          }
        },
        {
          "name": "Update Variant",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flavor\": \"Mango Mint\",\n  \"nicotineLevel\": \"5mg\",\n  \"price\": 27.50,\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/variants/{{variantId}}"
          }
        },
        {
          "name": "Delete Variant",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/variants/{{variantId}}"
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "List Inventory",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/inventory?productId=&variantId=&lowStock=false"
          }
        },
        {
          "name": "Update Inventory Stock",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 20\n}"
            },
            "url": "{{baseUrl}}/api/v1/inventory/{{variantId}}"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{clientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"variantId\": {{variantId}},\n      \"quantity\": 2\n    }\n  ],\n  \"shippingData\": {\n    \"recipientName\": \"Client Demo\",\n    \"phone\": \"3001234567\",\n    \"address\": \"Street 123\",\n    \"city\": \"Bogota\",\n    \"notes\": \"Call before delivery\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders"
          }
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/orders/my-orders?page=0&size=10"
          }
        },
        {
          "name": "Get Order Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}"
          }
        },
        {
          "name": "List Orders Admin",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/orders?page=0&size=10&status=&userId="
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PROCESSING\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/status"
          }
        }
      ]
    }
  ]
}
